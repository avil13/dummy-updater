{
  "$schema": "https://raw.githubusercontent.com/avil13/dummy-updater/master/schema/v1/schema.json",
  "log": {
    "max_err_mb": 1,
    "max_project_mb": 0.5,
    "retention_days": 7,
    "free_size": "10%"
  },
  "tg": {
    "enabled": false,
    "only_errors": false,
    "bot_token": "",
    "chat_id": ""
  },
  "items": [
    {
      "repo": "git@github.com:YOUR_USER/my-repo.git",
      "target": "/home/master/git/my-repo",
      "run": "docker compose up -d --build --remove-orphans",
      "retry": 3,
      "enabled": true
    }
  ]
}

#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
# Build the staged snapshot, not potentially unstaged source files.
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
git checkout-index --all --prefix="$TMP/"
cd "$TMP"
go test ./...
for OS in linux darwin; do
  for ARCH in amd64 arm64; do
    CGO_ENABLED=0 GOOS="$OS" GOARCH="$ARCH" go build -trimpath -ldflags="-s -w" -o "$TMP/updater-$OS-$ARCH" .
  done
done
mkdir -p "$ROOT/dist"
cd "$ROOT"
for OS in linux darwin; do
  for ARCH in amd64 arm64; do
    cp "$TMP/updater-$OS-$ARCH" "dist/updater-$OS-$ARCH"
    git add -- "dist/updater-$OS-$ARCH"
  done
done
